# Hob Configuration
# Copy this file to .env to override default constants

# Salesforce API version (default: 63.0)
HOB_API_VERSION=63.0

# Default package directory name (default: force-app)
HOB_PACKAGE_DIR=force-app

# Default Dev Hub alias (default: devhub)
HOB_DEVHUB_ALIAS=devhub

# Scratch org duration in days (default: 7)
HOB_SCRATCH_DURATION=7

# Scratch org definition file path (default: config/project-scratch-def.json)
HOB_SCRATCH_DEF_PATH=config/project-scratch-def.json

# Default permission sets to assign, comma-separated (e.g. MyPermSet,AnotherPermSet)
# HOB_SCRATCH_PERMSETS=

# Path to test data seed script (e.g. scripts/apex/seed.apex or data/data-plan.json)
# HOB_SCRATCH_SEED_SCRIPT=

# Test execution wait timeout in minutes (default: 10)
HOB_TEST_WAIT=10

# Collect code coverage by default during test runs (default: true)
HOB_TEST_COVERAGE=true

# Directory for lightweight scratch org data plans and seeds (default: data)
HOB_SEED_DIR=data
